# ---- Discord ----
DISCORD_TOKEN=your_discord_bot_token_here

# ---- LLM provider ----
# The first three are served from NVIDIA's endpoint, so one key covers
# them. They are tried in this order: the first one that answers does the
# work, and the next is the fallback.
#   1. LAGUNA_MODEL - poolside's code model. It goes first: it is the
#      fastest, and it handles tools, thinking and everything else.
#   2. MINIMAX_MODEL - the general model. It does the tasks and research.
#   3. NVIDIA_MODEL - Nemotron. The strongest, and the only one that can
#      read a picture.
NVIDIA_API_KEY=your_nvidia_api_key_here
LAGUNA_MODEL=poolside/laguna-xs-2.1
MINIMAX_MODEL=minimaxai/minimax-m3.1-flash
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_API_URL=https://integrate.api.nvidia.com/v1

# The last fallback: Groq, reached only when NVIDIA's endpoint is out for
# all three of the models above.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_API_URL=https://api.groq.com/openai/v1

# ---- Database (Supabase) ----
SUPABASE_URL=https://your-project.supabase.co/
SUPABASE_KEY=your_supabase_service_role_key

# ---- Code execution sandbox (Daytona) ----
DAYTONA_API_KEY=your_daytona_api_key_here
DAYTONA_API_URL=https://app.daytona.io/api

# ---- Web search (LangSearch) ----
LANGSEARCH_API_KEY=your_langsearch_api_key_here
LANGSEARCH_API_URL=https://api.langsearch.com/v1/web-search

# ---- Computational engine (Wolfram Alpha) ----
WOLFRAM_APP_ID=your_wolfram_alpha_app_id_here

# ---- Long-term memory ----
# Embedding model for semantic memory retrieval.
# nvidia/nemotron-3.5-embed-1b - 2048 dims, ~500ms per query.
EMBED_MODEL=nvidia/nemotron-3.5-embed-1b
# Relevance floor for retrieval. Memories scoring below this are not put in
# the prompt. 0.15 was measured to keep correct matches (0.33+) and drop
# unrelated ones (<=0.14).
MEMORY_MIN_SCORE=0.15
# How much a recent memory is favoured over an old one (0 = off).
MEMORY_RECENCY_WEIGHT=0.15
# After this many days a memory's recency bonus has halved.
MEMORY_HALF_LIFE_DAYS=90
# Cosine distance below which two memories count as revisions of each other,
# and the newer one wins. 0.25 separates a revision pair (0.83) from two
# unrelated facts (0.63).
MEMORY_DEDUPE_DISTANCE=0.25
# How many memories to keep per user before the least used are pruned.
MEMORY_CAP=2000
# The embeddings API is sometimes slow; retry rather than fail the turn.
MEMORY_EMBED_TIMEOUT=20
MEMORY_EMBED_ATTEMPTS=3

# ---- Kaggle (free cloud compute, datasets and trained models) ----
# The new-style API token from your Kaggle account's API tokens page.
# With this set, the bot can run scripts on Kaggle's free CPU/GPU, search
# Kaggle's datasets, and use its trained models.
# KAGGLE_API_TOKEN=KGAT_your_token_here
# Alternatively use the legacy ~/.kaggle/kaggle.json file.
